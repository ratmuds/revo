#include <Arduino.h>
#include <SerialTransfer.h>

// --- Hardware Pin Configurations for RS-485 ---
#define RS485_TX 16
#define RS485_RX 17
#define RS485_DE 18

// --- Connection Magic Numbers ---
#define MAGIC_TX 0x5245564F  // 'REVO' (Pi 5 -> Pico 2)
#define MAGIC_RX 0x53544154  // 'STAT' (Pico 2 -> Pi 5)

// Create distinct transfer managers
SerialTransfer usbTransfer;   // Pi 5 Link
SerialTransfer busTransfer;   // RS-485 Servos Link

// ============================================================================
// Data Structures Matching RS-485 Servos (ATtiny3216)
// ============================================================================
struct __attribute__((__packed__)) IncomingPacket {
  uint8_t targetPcbId;
  uint16_t targetAngle;
  uint8_t performHome;
  uint8_t rgbColor[3];
  uint16_t maxCurrent;
};

struct __attribute__((__packed__)) RespondPacket {
  uint8_t targetPcbId;
  uint16_t angle;
  uint8_t temp;
  uint16_t current;
  uint16_t voltage;
  uint8_t magnet;
  uint8_t homed;
  uint8_t servoFirmwareVersion;
};

IncomingPacket txData;
RespondPacket rxData;

// ============================================================================
// Data Structures Matching USB Protocol (48-Byte Symmetric Packets)
// ============================================================================
struct __attribute__((__packed__)) UsbServoCmd {
  uint16_t targetAngle;
  uint16_t maxCurrent;
  uint8_t rgbColor[3];
  uint8_t performHome;
};

struct __attribute__((__packed__)) UsbCommandPacket {
  uint32_t magic;
  UsbServoCmd servos[3];
  uint8_t padding[20]; // Aligns packet size to 48 bytes
};

struct __attribute__((__packed__)) UsbJointData {
  uint8_t online;
  uint16_t angle;
  uint8_t temp;
  uint16_t current;
  uint16_t voltage;
  uint8_t magnet;
  uint8_t homed;
  uint8_t fw;
};

struct __attribute__((__packed__)) UsbStatusPacket {
  uint32_t magic;
  uint32_t counter;
  UsbJointData joints[3];
  uint8_t padding[7]; // Aligns packet size to 48 bytes
};

// Global operational state buffers
UsbCommandPacket localCmd;
UsbStatusPacket localStatus;

const uint8_t MAX_PCBS = 3;
uint8_t currentPcbId = 0;

// ============================================================================
// Setup
// ============================================================================
void setup() {
  // Initialize USB Serial (Baud rate is ignored by USB stack; transfers at full bus speed)
  Serial.begin(115200); 
  usbTransfer.begin(Serial);
  
  // Initialize Hardware RS-485 Serial Port
  pinMode(RS485_DE, OUTPUT);
  digitalWrite(RS485_DE, LOW); 
  Serial1.setTX(RS485_TX);
  Serial1.setRX(RS485_RX);
  Serial1.begin(115200);        
  busTransfer.begin(Serial1);

  // Pre-seed baseline status values
  localStatus.magic = MAGIC_RX;
  localStatus.counter = 0;
  memset(localStatus.padding, 0, sizeof(localStatus.padding));
  for (int i = 0; i < MAX_PCBS; i++) {
    localStatus.joints[i].online = 0;
  }
}

// ============================================================================
// Main Execution Loop
// ============================================================================
void loop() {
  
  // 1. Check if the Raspberry Pi 5 sent instructions over USB
  if (usbTransfer.available()) {
    usbTransfer.rxObj(localCmd);

    // Guard statement against data corruption or misalignments
    if (localCmd.magic == MAGIC_TX) {
      
      // 2. Map current indexed motor targeting commands out to the RS-485 struct
      txData.targetPcbId = currentPcbId;
      txData.targetAngle = localCmd.servos[currentPcbId].targetAngle;
      txData.performHome  = localCmd.servos[currentPcbId].performHome;
      txData.maxCurrent   = localCmd.servos[currentPcbId].maxCurrent;
      txData.rgbColor[0]  = localCmd.servos[currentPcbId].rgbColor[0];
      txData.rgbColor[1]  = localCmd.servos[currentPcbId].rgbColor[1];
      txData.rgbColor[2]  = localCmd.servos[currentPcbId].rgbColor[2];

      // 3. Drive the RS-485 hardware pipeline 
      busTransfer.txObj(txData);
      
      digitalWrite(RS485_DE, HIGH);  // Enable Transmit
      delayMicroseconds(50);
      
      busTransfer.sendData(sizeof(txData));
      Serial1.flush();               // Wait for bytes to physically leave hardware TX FIFO
      
      delayMicroseconds(20); 
      digitalWrite(RS485_DE, LOW);   // Drop back to Listen mode
      
      // 4. Listen closely for the specific ATtiny response
      unsigned long startMillis = millis();
      bool responseReceived = false;
      
      while (millis() - startMillis < 15) { // 15ms window limit
        if (busTransfer.available()) {
          busTransfer.rxObj(rxData);
          responseReceived = true;
          break;
        }
      }
      
      // 5. Transfer data fields directly into the outbound USB telemetry slot
      if (responseReceived && (rxData.targetPcbId == currentPcbId)) {
        localStatus.joints[currentPcbId].online   = 1;
        localStatus.joints[currentPcbId].angle    = rxData.angle;
        localStatus.joints[currentPcbId].temp     = rxData.temp;
        localStatus.joints[currentPcbId].current  = rxData.current;
        localStatus.joints[currentPcbId].voltage  = rxData.voltage;
        localStatus.joints[currentPcbId].magnet   = rxData.magnet;
        localStatus.joints[currentPcbId].homed    = rxData.homed;
        localStatus.joints[currentPcbId].fw       = rxData.servoFirmwareVersion;
      } else {
        // Drop the servo offline if communication failed
        localStatus.joints[currentPcbId].online   = 0;
      }

      // 6. Respond immediately back to the Pi over USB
      localStatus.counter++;
      usbTransfer.txObj(localStatus);
      usbTransfer.sendData(sizeof(localStatus));

      // 7. Step to the next servo PCB ID in the network sequence
      currentPcbId++;
      if (currentPcbId >= MAX_PCBS) {
        currentPcbId = 0;
      }
    }
  }
}